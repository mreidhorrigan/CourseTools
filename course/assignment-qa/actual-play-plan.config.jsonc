  "rubric_file": "$ENGINE/course/content/rubrics/actual-play-plan.json",
  "context_files": ["$ENGINE/course/content/syllabus.html"],
  "expected_requirements": [
    "Submit one PDF.", "Include playable rules and a playable situation.",
    "Identify consequential player choices.", "Define consent and safety procedures.",
    "Define recording workflow and role assignments.", "Include an accessibility plan.",
    "State a testable dry-run question, evidence to collect, schedule, and observable definition of done.",
    "Append complete relevant AI chatlogs or state that no AI was used."
