// Builds a sanitized collaborator ZIP at release/canvas-automation-toolkit.zip. The ZIP bytes
// are deterministic for the same recipe and locked environments.
// Course-specific material, credentials, .git, venvs, and output are excluded.
// A generated index.html sits at the archive root.
{
  // "$schema": "./build-distribution.schema.json",
  "OUT_DIR": "$ENGINE/out/distribution", // temporary, automatically pruned build workspace
  "release_dir": "$ENGINE/release", // the single, clearly named collaborator release location
  "retained_timestamped_builds": 0, // avoid accumulating confusing intermediate snapshots
  "archive_name": "canvas-automation-toolkit.zip",
  "disclosed_content": "The attributed IAT 210 example course intentionally contains public instructor, institutional, and course information documented in examples/iat210/README.md.",
  // Local course-maintenance files excluded from the collaborator package. Review this list
  // before distributing a different example course.
  "exclude_paths": [
    "docs/SESSION_CLOSEOUT_2026-08-20.md",
    "commands/update-canvas-from-authoring.command",
    "course/PENDING-LIVE-UPDATE.md",
    "scripts/build_iat210_materials_update.py",
    "scripts/finalize_imported_course.py",
    "scripts/restore_imscc_native_content.py",
    "scripts/verify_imported_course.py",
    "tests/test_iat210_materials_update.py",
    "scripts/configure_iat210_course.py",
    "scripts/install_iat210_reading.py",
    "scripts/verify_iat210_454.py",
    "scripts/outtake_library_search_links.py",
    "scripts/replace_stale_week_pages.py",
    "scripts/update_iat210_syllabus_454.py",
    "tests/test_iat210_configure.py",
    "tests/test_iat210_package.py",
    "tests/test_iat210_starter_builder.py",
    "tests/test_import_finalizer.py",
    "tests/test_imported_course_verifier.py",
    "tests/test_native_content_restore.py"
  ]
}
