{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mistral assignment and rubric boundary testing",
  "type": "object",
  "additionalProperties": false,
  "required": ["OUT_DIR", "instructions_file", "rubric_file", "context_files", "expected_requirements", "student_profiles", "trials", "seed", "model", "api_url", "student_temperature", "grader_temperature", "student_max_tokens", "analysis_max_tokens", "max_input_chars", "timeout_seconds", "retry_attempts", "retry_base_seconds"],
  "properties": {
    "OUT_DIR": {"type": "string", "minLength": 1},
    "instructions_file": {"type": "string", "minLength": 1},
    "rubric_file": {"type": "string", "minLength": 1},
    "context_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "expected_requirements": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "student_profiles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "trials": {"type": "integer", "minimum": 1, "maximum": 12},
    "seed": {"type": "integer", "minimum": 0},
    "model": {"type": "string", "minLength": 1},
    "api_url": {"type": "string", "minLength": 1},
    "student_temperature": {"type": "number", "minimum": 0, "maximum": 1},
    "grader_temperature": {"type": "number", "minimum": 0, "maximum": 1},
    "student_max_tokens": {"type": "integer", "minimum": 128, "maximum": 10000},
    "analysis_max_tokens": {"type": "integer", "minimum": 128, "maximum": 10000},
    "max_input_chars": {"type": "integer", "minimum": 1000, "maximum": 500000},
    "timeout_seconds": {"type": "integer", "minimum": 10, "maximum": 600},
    "retry_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
    "retry_base_seconds": {"type": "number", "minimum": 1, "maximum": 60}
  }
}
